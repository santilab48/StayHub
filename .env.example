# StayHub development / Railway staging configuration. NEVER commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PostgreSQL connection is SERVER ONLY, configured using Railway service variable reference.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Old Supabase routes remain during P1.5 migration. Use STAGING credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEVER prefix private keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared dashboard ad layout. Mock only for isolated tests and staging previews.
NEXT_PUBLIC_ENABLE_AD_MOCK=false
# Runtime switches for each slot, including mock mode. Set false to unmount a slot.
STAYHUB_AD_ENABLE_LEFT=true
STAYHUB_AD_ENABLE_RIGHT=true
STAYHUB_AD_ENABLE_BOTTOM=true
NEXT_PUBLIC_ENABLE_CONTENT_AD_LIVE=false
NEXT_PUBLIC_ENABLE_INPAGE_PUSH_LIVE=false
NEXT_PUBLIC_ENABLE_RIGHT_AD_LIVE=false
NEXT_PUBLIC_ENABLE_BOTTOM_AD_LIVE=false
NEXT_PUBLIC_ENABLE_FIRST_ENTRY_AD_LIVE=false
# Server-only staging gate; keep unset until category controls are independently verified.
# STAYHUB_AD_SITE_ID=932445
# STAYHUB_AD_ALL_AGES_APPROVED=1
# STAYHUB_AD_ALLOWED_HOSTS=shameful-farm.com,another-reviewed-provider.example
# STAYHUB_AD_LEFT_URL=https://shameful-farm.com/<approved-left-zone-path>
# STAYHUB_AD_RIGHT_URL=https://shameful-farm.com/<approved-right-zone-path>
# STAYHUB_AD_BOTTOM_URL=https://shameful-farm.com/<approved-bottom-zone-path>
