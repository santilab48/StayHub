# StayHub development / Railway staging configuration. NEVER commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PostgreSQL connection is SERVER ONLY, configured using Railway service variable reference.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Old Supabase routes remain during P1.5 migration. Use STAGING credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEVER prefix private keys with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Shared dashboard ad layout. Mock only for isolated tests and staging previews.
NEXT_PUBLIC_ENABLE_AD_MOCK=false
STAYHUB_AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6386708667648997
NEXT_PUBLIC_ADSENSE_LEFT_SLOT=
NEXT_PUBLIC_ADSENSE_RIGHT_SLOT=
NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=
STAYHUB_AD_LEFT_ENABLED=false
STAYHUB_AD_RIGHT_ENABLED=false
STAYHUB_AD_BOTTOM_ENABLED=false
# Server-only gates: set only after Google site approval, Ad Units, and Brand safety review.
# STAYHUB_ADSENSE_APPROVED=true
# STAYHUB_AD_ALL_AGES_APPROVED=1
